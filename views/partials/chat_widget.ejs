<!-- Floating Chat Widget -->
<style>
  .chat-float-btn {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #0f5ca8;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(15,92,168,0.25);
    cursor: pointer;
    z-index: 9999;
    border: none;
  }

  .chat-panel {
    position: fixed;
    right: 20px;
    bottom: 88px;
    width: min(360px, calc(100vw - 40px));
    max-width: calc(100% - 40px);
    height: 520px;
    max-height: calc(100vh - 120px);
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 24px 80px rgba(2,6,23,0.2);
    display: none;
    flex-direction: column;
    overflow: hidden;
    z-index: 9999;
  }

  .chat-panel.open { display: flex; }

  .chat-panel .panel-header {
    padding: 12px 14px;
    background: linear-gradient(90deg,#0f5ca8,#3873fd);
    color: #fff;
    font-weight: 700;
  }

  .chat-panel .panel-body {
    padding: 12px;
    background: #f7f9fc;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow-y: auto;
    flex: 1 1 auto;
  }

  .chat-panel .panel-footer {
    padding: 10px;
    background: #fff;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .chat-panel .chat-message {
    max-width: 85%;
    padding: 10px 12px;
    border-radius: 12px;
    line-height: 1.4;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .chat-panel .chat-message.user { align-self: flex-end; background: #0f5ca8; color: #fff; }
  .chat-panel .chat-message.bot { align-self: flex-start; background: #e9effc; color: #102a43; }

  .chat-suggestions { display:flex; flex-wrap:wrap; gap:8px; }
  .chat-suggestions button { padding:6px 10px; border-radius:999px; border:1px solid #d3dae8; background:#fff; cursor:pointer; }

  @media (max-width:480px) {
    .chat-panel { right: 10px; left: 10px; bottom: 80px; width: auto; height: 60vh; }
    .chat-panel .panel-footer { flex-wrap: wrap; }
    .chat-panel .panel-footer input, .chat-panel .panel-footer button { width: 100%; }
    .chat-float-btn { right: 12px; bottom: 12px; }
  }
</style>

<button id="chat-toggle" class="chat-float-btn" aria-label="Open chat">💬</button>

<div id="chat-panel" class="chat-panel" aria-hidden="true">
  <div class="panel-header">Assistant</div>
  <div id="chat-body" class="panel-body"></div>
  <div style="padding:0 12px;">
    <div id="chat-suggestions" class="chat-suggestions"></div>
  </div>
  <div class="panel-footer">
    <input id="chat-input" class="chat-input" placeholder="Ask the assistant..." style="flex:1;padding:10px 12px;border-radius:999px;border:1px solid #d3dae8;outline:none;" />
    <button id="chat-send" class="chat-send" style="background:#0f5ca8;color:#fff;padding:8px 12px;border-radius:999px;border:none;">Send</button>
  </div>
</div>

<script>
(function(){
  const toggle = document.getElementById('chat-toggle');
  const panel = document.getElementById('chat-panel');
  const body = document.getElementById('chat-body');
  const input = document.getElementById('chat-input');
  const send = document.getElementById('chat-send');
  const suggestions = document.getElementById('chat-suggestions');

  function appendMessage(text, role){
    const el = document.createElement('div');
    el.className = 'chat-message ' + role;
    el.textContent = text;
    body.appendChild(el);
    body.scrollTop = body.scrollHeight;
    return el;
  }

  function renderSuggestions(items){
    suggestions.innerHTML = '';
    if(!items || !items.length) return;
    items.forEach(s=>{
      const btn = document.createElement('button');
      btn.type = 'button';
      const label = (typeof s === 'string') ? s : (s.label || 'Suggestion');
      btn.textContent = label;

      if (typeof s === 'string') {
        btn.addEventListener('click', ()=>{ input.value = s; input.focus(); });
      } else if (s && s.url) {
        btn.addEventListener('click', ()=>{ window.location.href = s.url; });
      } else {
        btn.addEventListener('click', ()=>{ input.value = label; input.focus(); });
      }

      suggestions.appendChild(btn);
    });
  }

  async function sendMessage(msg){
    if(!msg) return;
    appendMessage(msg, 'user');
    input.value='';
    const loading = appendMessage('Typing...', 'bot');
    try{
      const res = await fetch('/chatbot', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ message: msg }) });
      const data = await res.json();
      loading.remove();
      if(res.ok && data.reply){
        appendMessage(data.reply, 'bot');
        renderSuggestions(data.suggestions || []);
      } else {
        appendMessage(data.error || 'No response', 'bot');
        renderSuggestions([]);
      }
    } catch(err){
      loading.remove();
      appendMessage('Error connecting to assistant', 'bot');
      renderSuggestions([]);
    }
  }

  toggle.addEventListener('click', ()=>{
    const open = panel.classList.toggle('open');
    panel.setAttribute('aria-hidden', !open);
    if(open) {
      // load greeting
      if(body.children.length===0){
        sendMessage('');
      }
    }
  });

  send.addEventListener('click', ()=> sendMessage(input.value.trim()));
  input.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ e.preventDefault(); sendMessage(input.value.trim()); } });
})();
</script>
