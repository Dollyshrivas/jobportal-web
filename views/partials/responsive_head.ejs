<style>
  :root {
    --site-max: 1200px;
    --page-gutter: 16px;
  }

  html { scroll-behavior: smooth; }
  body, input, button, textarea, select { font-family: Inter, 'Segoe UI', Arial, sans-serif; }
  * { box-sizing: border-box; }
  img, picture, svg, video { max-width: 100%; height: auto; display: block; }

  /* Navbar defaults */
  .navbar { position: sticky !important; top: 0 !important; z-index: 999 !important; width: 100% !important; }
  .nav-container { width: 100% !important; max-width: var(--site-max) !important; margin: 0 auto !important; padding: 14px var(--page-gutter) !important; display: flex !important; align-items: center !important; justify-content: space-between !important; flex-wrap: wrap !important; }
  .navbar-brand { width: auto !important; margin-bottom: 0 !important; }
  .nav-links { width: auto !important; display: flex !important; flex-wrap: wrap !important; gap: 10px !important; align-items: center !important; justify-content: flex-end !important; padding: 0 !important; margin: 0 !important; list-style: none !important; }
  .nav-links li { width: auto !important; display: inline-flex !important; }
  .nav-links a, .nav-apply { display: inline-flex !important; align-items: center !important; justify-content: center !important; width: auto !important; padding: 10px 14px !important; }

  /* Layout helpers */
  .page-content, .container, .job-result-wrapper, .applyform-container, .hero, .hero-section, .dashboard-shell, .footer, .footer-container, .register-container, .forgot-container, .login-container, .login-card { width: 100% !important; max-width: 100% !important; padding-left: var(--page-gutter) !important; padding-right: var(--page-gutter) !important; }
  .job-card, .default-job-card, .insight-panel, .summary-card, .application-card, .job-form, .card, form { width: 100% !important; max-width: 100% !important; }
  .job-actions, .action-buttons, .chat-form, .search-form { flex-wrap: wrap !important; gap: 10px !important; }

  @media (max-width: 900px) {
    .nav-links { flex-direction: column !important; align-items: stretch !important; width: 100% !important; }
    .nav-links li { width: 100% !important; }
    .nav-links a, .nav-apply { width: 100% !important; justify-content: flex-start !important; }
    .hero, .hero-section, .dashboard-shell { padding-left: 16px !important; padding-right: 16px !important; }
    .hero { flex-direction: column !important; gap: 16px !important; }
    .search-form, .chat-form { flex-direction: column !important; align-items: stretch !important; }
    .search-form input, .search-form button, .chat-input, .chat-submit { width: 100% !important; }
    .job-actions, .action-buttons { flex-direction: column !important; align-items: stretch !important; }
    .footer-container { padding-left: 16px !important; padding-right: 16px !important; }
  }

  @media (max-width: 640px) {
    .nav-container { padding: 12px 14px !important; }
    .navbar-brand { font-size: 1.25rem !important; }
    .nav-links a, .nav-apply { font-size: 1rem !important; padding: 12px 14px !important; }
    .hero-title, .section-title, .job-result-title, .profile-box h2, .job-card h3, .summary-card strong { font-size: clamp(1.1rem, 4vw, 1.8rem) !important; }
    .chat-panel { right: 10px !important; left: 10px !important; bottom: 80px !important; width: auto !important; height: 60vh !important; }
    .chat-panel .panel-footer input, .chat-panel .panel-footer button { width: 100% !important; }
  }
</style>
