<!DOCTYPE html>
<html lang="en">
<head>
  <title>Login</title>
  <%- include('partials/site_head') %>
  <style>
    .center-shell{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:40px}
    .login-card{width:100%;max-width:420px;padding:28px;border-radius:12px;background:#fff;box-shadow:0 12px 30px rgba(2,6,23,0.06)}
    .login-card h2{margin-bottom:8px}
    .muted{color:var(--muted)}
    .form-group{margin-bottom:12px}
    .login-btn{width:100%;padding:10px;border-radius:10px;background:var(--accent);color:#fff;border:none}

    @media (max-width: 640px) {
      .center-shell { padding: 18px; }
      .login-card { padding: 22px; margin: 0 10px; }
      .login-btn { padding: 14px; }
    }
  </style>
</head>
<body>
  <div class="center-shell">
    <div class="login-card">
      <% if (success && success.length > 0) { %>
        <div class="flash success"><%= success[0] %></div>
      <% } %>

      <% if (error && error.length > 0) { %>
        <div class="flash error"><%= error[0] %></div>
      <% } %>

      <h2>Sign in to your account</h2>
      <p class="muted">Enter your credentials to continue</p>

      <form action="/loginpage" method="POST" style="margin-top:16px">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="you@company.com" required />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="Your password" required />
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
          <a href="/forgotpassword" class="muted">Forgot password?</a>
          <a href="/registerpage" class="muted">Create account</a>
        </div>

        <button type="submit" class="login-btn">Sign in</button>
      </form>
    </div>
  </div>
</body>
</html>