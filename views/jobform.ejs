<!DOCTYPE html>
<html lang="en">
<head>
  <title>Applying for job</title>
  <%- include('partials/site_head') %>
  <style>
      
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}


body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background: linear-gradient(135deg, #e3f2fd, #f4f6f8);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}


form {
  background: #ffffff;
  padding: 30px;
  width: 100%;
  max-width: 420px;
  border-radius: 12px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
}


label {
  display: block;
  margin-bottom: 6px;
  font-weight: 600;
  color: #333;
}


input {
  width: 100%;
  padding: 11px 12px;
  margin-bottom: 18px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 14px;
}


input:focus {
  outline: none;
  border-color: #4a90e2;
}


button[type="submit"] {
  width: 100%;
  padding: 13px;
  background: #4a90e2;
  color: #ffffff;
  border: none;
  border-radius: 8px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}


button[type="submit"]:hover {
  background: #357abd;
  transform: translateY(-2px);
  box-shadow: 0 6px 15px rgba(74, 144, 226, 0.4);
}

.applyform-container{
  width: min(100%, 520px);
  margin: 36px auto 0;
  padding: 0 18px;
}

h2{
  text-align: center;
  margin-bottom: 18px;
  padding: 0;
}

@media (max-width: 640px) {
  body { padding: 16px 0 30px; }
  .applyform-container { padding: 0 14px; }
  form { padding: 24px; }
}

    </style>
</head>
<body>
    <div class="applyform-container">
      <h2>Apply for</h2>

<form action="/applyform" method="POST">

  <% if (typeof job !== 'undefined' && job) { %>
    <p style="margin-bottom:12px;"><strong>Position:</strong> <%= job.Name %> — <%= job.Role %> (<%= job.Location %>)</p>
    <input type="hidden" name="jobId" value="<%= job._id %>">
  <% } %>

  <div class="form-name">
    <label>Name</label>
  <input type="text" name="Name" required>
  </div>

  <div class="form-skill">
    <label>Skills</label>
  <input type="text" name="Skills" required>
  </div>

  <div class="form-phonenumber">
    <label>Phone Number</label>
  <input type="text" name="Phonenumber" required>
  </div>

  <div class="form-location">
    <label>Location</label>
  <input type="text" name="Location" value="<%= job ? job.Location : '' %>" required>
  </div>

  <div class="form-submit">
    <button type="submit">Submit Application</button>
</form>
  </div>
    </div>

</body>
</html>