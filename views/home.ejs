<!DOCTYPE html>
<html lang="en">
<head>
  <title>Job App</title>
  <%- include('partials/site_head') %>
  <style>
      :root {
  --bg: #f4f7fb;
  --nav: #03045E;
  --accent: #3873fd;
  --card: #ffffff;
  --text: #111827;
  --muted: #6b7280;
  --radius: 12px;
  --shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: "Segoe UI", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

/* ===========================
        NAVBAR
=========================== */

.navbar {
  width: 100%;
  background: var(--nav);
  box-shadow: 0 5px 15px rgba(0,0,0,.15);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.nav-container {
  max-width: 1200px;
  margin: auto;
  height: 70px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 25px;
}

.navbar-brand {
  color: white;
  text-decoration: none;
  font-size: 1.6rem;
  font-weight: bold;
}

.nav-links {
  list-style: none;
  display: flex;
  gap: 15px;
}

.nav-links a {
  color: white;
  text-decoration: none;
  padding: 10px 14px;
  border-radius: 6px;
  transition: .3s;
}

.nav-links a:hover {
  background: rgba(255,255,255,.18);
}

/* ===========================
          HERO
=========================== */

.hero {
  max-width: 1200px;
  margin: auto;
  padding: 60px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}

.hero-left {
  flex: 1;
}

.hero-title {
  font-size: 2.4rem;
  color: var(--nav);
  margin-bottom: 15px;
}

.hero-sub {
  color: var(--muted);
  margin-bottom: 30px;
  font-size: 17px;
}

/* ===========================
      SEARCH BAR
=========================== */

.search-form {
  display: flex;
  max-width: 550px;
  background: white;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.search-form input {
  flex: 1;
  border: none;
  outline: none;
  padding: 15px;
  font-size: 16px;
}

.search-form button {
  background: var(--accent);
  color: white;
  border: none;
  padding: 15px 25px;
  cursor: pointer;
  transition: .3s;
}

.search-form button:hover {
  background: #245ce4;
}

/* ===========================
      JOB SECTION
=========================== */

.jobs-section {
  max-width: 1200px;
  margin: auto;
  padding: 20px;
}

.jobs-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
  gap: 25px;
}

/* ===========================
      JOB CARD
=========================== */

.job-card {
  background: white;
  border-radius: var(--radius);
  padding: 20px;
  box-shadow: var(--shadow);
  transition: .35s;
  animation: slideLeft .6s ease;
  display: flex;
  flex-direction: column;
}

.job-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 35px rgba(0,0,0,.15);
}

.job-card h3 {
  color: var(--nav);
  margin-bottom: 10px;
}

.job-meta {
  color: var(--muted);
  margin-bottom: 15px;
}

.job-card p {
  color: #555;
  margin-bottom: 15px;
}

/* ===========================
      BUTTONS
=========================== */

.job-actions {
  display: flex;
  gap: 10px;
  margin-top: auto;
}

.apply-btn,
.view-btn {
  flex: 1;
  padding: 11px;
  border-radius: 8px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  transition: .3s;
}

.apply-btn {
  background: var(--accent);
  border: none;
  color: white;
}

.apply-btn:hover {
  background: #245ce4;
}

.view-btn {
  border: 1px solid #ddd;
  color: #444;
  background: white;
}

.view-btn:hover {
  background: #f3f4f6;
}

/* ===========================
      NO JOB
=========================== */

.no-job-text {
  text-align: center;
  padding: 50px;
  color: gray;
}

/* ===========================
        FOOTER
=========================== */

.footer {
  margin-top: 60px;
  background: #0f172a;
  color: white;
}

.footer-container {
  max-width: 1200px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  gap: 40px;
  padding: 40px 20px;
  flex-wrap: wrap;
}

.footer-section {
  flex: 1;
  min-width: 220px;
}

.footer-section h3,
.footer-section h4 {
  margin-bottom: 15px;
}

.footer-section p {
  color: #d8d8d8;
}

.footer-section ul {
  list-style: none;
}

.footer-section li {
  margin: 10px 0;
}

.footer-section a {
  color: white;
  text-decoration: none;
  transition: .3s;
}

.footer-section a:hover {
  color: #9fc2ff;
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,.15);
  text-align: center;
  padding: 15px;
}

/* ===========================
      ANIMATION
=========================== */

@keyframes slideLeft {

  from {
    opacity: 0;
    transform: translateX(-50px);
  }

  to {
    opacity: 1;
    transform: translateX(0);
  }

}

/* ===========================
      RESPONSIVE
=========================== */

@media(max-width:768px){

.nav-container{

flex-direction:column;
height:auto;
padding:20px;

}

.nav-links{

width:100%;
flex-direction:column;
margin-top:15px;

}

.nav-links a{

display:block;
width:100%;

}

.hero{

flex-direction:column;
text-align:center;

}

.hero-title{

font-size:2rem;

}

.search-form{

width:100%;

}

.job-actions{

flex-direction:column;

}

.footer-container{

flex-direction:column;
text-align:center;

}

}

@media(max-width:500px){

.hero-title{

font-size:1.6rem;

}

.search-form{

flex-direction:column;

}

.search-form button{

width:100%;

}

}
 
    </style>
</head>
<body>

  <nav class="navbar">
    <div class="nav-container"> 
      <a class="navbar-brand" href="/">Job App</a>
      <ul class="nav-links">
        <% if (user) { %>
          <li><a href="/profilepage">Profile</a></li>
          <li><a href="/applyjob">Browse Jobs</a></li>
          <li><a href="/createjob">Post Job</a></li>
          <li><a href="/logout">Logout</a></li>
        <% } else { %>
          <li><a href="/applyjob">Browse Jobs</a></li>
          <li><a href="/loginpage">Login</a></li>
        <% } %>
      </ul>
      </div>
    </nav>
    <main class="hero">
      <div class="hero-left">
        <h1 class="hero-title">Find your next opportunity</h1>
        <p class="hero-sub">Search thousands of jobs and apply in a few clicks. Personalised suggestions powered by your portal.</p>
        <form class="search-form" action="/" method="GET">
          <input type="text" name="q" placeholder="e.g. Frontend Developer, Marketing" value="<%= typeof q !== 'undefined' ? q : '' %>" />
          <button type="submit">Search</button>
        </form>
      </div>
      <div class="hero-right">
        <!-- reserved for future stats or illustration -->
      </div>
    </main>

    <section class="jobs-section">
      <% if (typeof q !== 'undefined') { %>
        <% if (jobs.length > 0) { %>
          <div style="max-width:1200px;margin:12px auto 18px;padding:0 24px;"><h2 style="margin:0 0 12px;color:#0f172a">Results for "<%= q %>"</h2></div>
          <div class="jobs-grid">
            <% jobs.forEach(job => { %>
              <article class="job-card">
                <h3><%= job.Name %></h3>
                <div class="job-meta"><%= job.Role %> • <%= job.Location %></div>
                <p style="color:var(--muted);font-size:0.95rem">Posted: <%= job.createdAt ? job.createdAt.toDateString() : 'N/A' %></p>
                <div class="job-actions">
                  <form action="/applybutton" method="GET" style="margin:0">
                      <input type="hidden" name="jobId" value="<%= job._id %>">
                      <button class="apply-btn" type="submit">Apply</button>
                    </form>
                  <a class="view-btn" href="/apply/<%= job._id %>">View</a>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="no-job-text">No jobs found for "<strong><%= q %></strong>"</p>
        <% } %>
      <% } else { %>
        <div style="max-width:1200px;margin:12px auto 18px;padding:0 24px;"><h2 style="margin:0 0 12px;color:#0f172a">Latest jobs</h2></div>
        <div class="jobs-grid">
          <% jobs.slice(0,6).forEach(job => { %>
            <article class="job-card">
              <h3><%= job.Name %></h3>
              <div class="job-meta"><%= job.Role %> • <%= job.Location %></div>
                <div class="job-actions">
                <form action="/applybutton" method="GET" style="margin:0">
                  <input type="hidden" name="jobId" value="<%= job._id %>">
                  <button class="apply-btn" type="submit">Apply</button>
                </form>
                <a class="view-btn" href="/apply/<%= job._id %>">View</a>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

</div>
<footer class="footer">
  <div class="footer-container">

    <div class="footer-section">
      <h3>Job App</h3>
      <p>Your trusted platform to search and apply for jobs easily.</p>
    </div>

    <div class="footer-section">
      <h4>Quick Links</h4>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/applyjob">Apply Jobs</a></li>
        <li><a href="/loginpage">Login</a></li>
      </ul>
    </div>

    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email: support@jobapp.com</p>
      <p>Phone: +91 9971018840</p>
    </div>

  </div>

  <div class="footer-bottom">
    <p>© 2026 Job App | All Rights Reserved</p>
  </div>
</footer>

<%- include("partials/chat_widget.ejs") %>

</body>
</html>