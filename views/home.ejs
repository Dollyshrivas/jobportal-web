    </style>
</head>
<body>
  <nav class="navbar">
    <div class="nav-container">
  <a class="navbar-brand" href="/">Job App</a>
  <ul class="nav-links">
      <li>
        <a class="nav-apply" href="/applyjob">Apply</a>
        <!--
        <li class="user-dropdown">
  <a href="#" class="user-name">User ▾</a>
  <ul class="dropdown-menu">
    <li><a href="/logout">Logout</a></li>
  </ul>
</li>
-->

<li>
  <a class="nav-login" href="/loginpage">Login</a>
</li>

    </ul>
</div>
</nav>

<div class="container">
  <h2 class="title">Add New Job</h2>
<form action="/jobs" method="POST" class="job-form">
  <input type="text" name="Name" placeholder="Name" required>
  <input type="text" name="Role" placeholder="Role" required>
  <input type="text" name="Location" placeholder="Location" required>
  <button type="submit" class="btn add-btn">Add</button>
</form>


<% jobs.forEach(job => {%>
  <div class="job-card">
  <form action="/jobs/update/<%= job.id%>" method="POST" class="job-form">
    <input type="text" name="Name" value="<%=job.Name%>">
    <input type="text" name="Role" placeholder="<%= job.Role%>">
    <input type="text" name="Location" placeholder="<%= job.Location%>">

    <div class="action-buttons"></div>
    <button type="submit" class="btn update-btn">Update</button>
  </div>
  </form>
  <form action="/jobs/delete/<%=job.id%>" method="POST">
    <button type="submit" class="btn delete-btn">Delete</button>
  </form>
</div>
<%})%>
</div>


</body>
</html>