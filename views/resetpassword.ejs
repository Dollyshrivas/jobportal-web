<!DOCTYPE html>
<html lang="en">
<head>
  <title>Reset Password</title>
  <%- include('partials/site_head') %>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, Helvetica, sans-serif;
    }

    body {
      height: 100vh;
      background: linear-gradient(135deg, #6b84f6, #e9e7ec);
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .login-container {
      background: #fff;
      padding: 30px;
      width: 100%;
      max-width: 350px;
      border-radius: 10px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    }

    h2 {
      text-align: center;
      margin-bottom: 20px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    label {
      font-weight: bold;
      font-size: 14px;
    }

    input {
      width: 100%;
      padding: 10px;
      margin-top: 5px;
      border: 1px solid #ccc;
      border-radius: 5px;
    }

    .login-btn {
      width: 100%;
      padding: 10px;
      background: #667eea;
      color: #fff;
      border: none;
      border-radius: 5px;
      cursor: pointer;
      margin-top: 10px;
    }

    .login-btn:hover {
      background: #5a67d8;
    }

    .flash {
      text-align: center;
      margin-bottom: 10px;
      font-size: 14px;
    }

    .flash.error { color: red; }
    .flash.success { color: green; }
  </style>
</head>
<body>

  <div class="login-container">

    <% if (success && success.length > 0) { %>
      <div class="flash success"><%= success[0] %></div>
    <% } %>

    <% if (error && error.length > 0) { %>
      <div class="flash error"><%= error[0] %></div>
    <% } %>

    <h2>Reset Password</h2>

    <!-- ONE FORM ONLY -->
    <form action="/resetpassword/<%= token %>" method="POST">

      <div class="form-group">
        <label>New Password</label>
        <input type="password" name="new_password" required>
      </div>

      <div class="form-group">
        <label>Confirm Password</label>
        <input type="password" name="confirm_new_password" required>
      </div>

      <button type="submit" class="login-btn">Reset Password</button>
    </form>

  </div>

</body>
</html>
